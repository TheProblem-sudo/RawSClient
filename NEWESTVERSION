    input.onchange = () => {
      cfg[key] = input.checked;
      save();
      refreshContext();
    };

    row.append(input);
    parent.append(row);
  }

  function aaSelect(parent, label, key, options, rerender = false) {
    const row = elem('label', 'field');
    row.append(elem('span', '', label));
    const input = elem('select');
    for (const [value, text] of options) {
      const option = elem('option', '', text);
      option.value = value;
      input.append(option);
    }
    input.value = cfg[key];
    input.onchange = () => {
      cfg[key] = input.value; save();
      if (rerender) renderPage();
      else refreshContext();
    };
    row.append(input);
    parent.append(row);
  }

  function aaNumber(value, min, max, fallback) {
    const number = Number(value);
    const fallbackNumber = Number(fallback);
    const safeNumber = Number.isFinite(number)
      ? number
      : (Number.isFinite(fallbackNumber) ? fallbackNumber : min);
    return Math.max(min, Math.min(max, safeNumber));
  }

  function aaRange(parent, label, key, min, max, step, unit) {
    const row = elem('label', 'field');
    const text = elem('span');
    const input = elem('input');
    Object.assign(input, {type:'range', min:String(min), max:String(max), step:String(step), value:String(cfg[key])});
    input.style.width = '150px';
    const update = () => {
      cfg[key] = aaNumber(input.value, min, max, defaults[key]);
      text.textContent = label + ': ' + cfg[key] + unit;
    };
    update();
    input.oninput = () => { update(); save(); refreshContext(); };
    row.append(text, input);
    parent.append(row);
  }

  function colorField(parent, label, key) {
    const row = elem('label', 'field');
    row.append(elem('span', '', label));
    const input = elem('input');
    input.type = 'color';
    input.value = cfg[key];
    input.oninput = () => { cfg[key] = input.value; save(); refreshContext(); };
    row.append(input);
    parent.append(row);
  }

  function textField(parent,label,key,placeholder='') {
    const row=elem('label','field');
    row.append(elem('span','',label));
    const input=elem('input');
    input.type='text';input.value=cfg[key]||'';input.placeholder=placeholder;
    input.onchange=()=>{cfg[key]=input.value.trim();save();refreshContext();};
    row.append(input);parent.append(row);
