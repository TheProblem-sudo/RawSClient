  const normalizedAgentBones=agent=>{
    const bones=agent?.bones;
    if (!bones) return new Map();
    let cached=agentBoneCaches.get(agent);
    if (!cached||cached.bones!==bones) {
      cached={bones,normalized:new Map(Object.entries(bones).map(
        ([name,bone])=>[name.toLowerCase(),bone]))};
      agentBoneCaches.set(agent,cached);
    }
    return cached.normalized;
  };
  const characterEntities = g => {
    const entities = typeof g?.allEntities === 'function' ? [...g.allEntities()] :
      (Array.isArray(g?.botMgr?.bots) ? g.botMgr.bots : Object.values(g?.botMgr?.bots || {}));
    return entities.filter(entity => entity && entity !== g?.player &&
      (entity.team === 'T' || entity.team === 'CT'));
  };

  const KEY = 'clutcher.darkgui.heldskin.v1';
  const SKIN_KNIFE_MODELS = [
    'knife_butterfly',
    'knife_flip',
    'knife_gut',
    'knife_karambit',
    'knife_m9',
    'knife_huntsman'
  ];
  const SKIN_FIREARM_IDS = [
    'glock','usps','p2000','dualies','p250','fiveseven','tec9','cz75','deagle','r8',
    'mac10','mp9','mp7','mp5sd','ump45','p90','bizon','nova','xm1014','sawedoff',
    'mag7','m249','negev','galil','famas','ak47','m4a4','m4a1s','sg553','aug',
    'ssg08','awp','g3sg1','scar20'
  ];

  const UI_ACCENT = '#39ff14';
  const defaults = {
    x: null, y: null, tab: 'Visuals',
    espShowTeammates: false,
    boxESP: false, cornerBoxESP: false, boxFill: false, boxFillOpacity: 12,
    boxVisibleColor: '#39ff14', boxHiddenColor: '#1d7f0b',
    boxTeamColor: '#3d8bff', boxFillColor: '#39ff14',
    headDotESP: false, headDotSize: 3,
    espMaxDistance: 0, espOpacity: 100, boxThickness: 2,
    espCrosshairLines: false,
    espEnemyColor: '#39ff14', espTeamColor: '#3d8bff',
    silentAim: false, silentFov: 120, silentCircle: true,
    triggerDelay: false, triggerDelayMs: 80,
    silentCircleColor: '#39ff14', silentCircleOpacity: 85, silentCircleWidth: 1.25,
    crosshairEnabled: false, crosshairColor: '#f5f5f8',
    crosshairSize: 8, crosshairGap: 4, crosshairWidth: 2,
    crosshairDot: false, crosshairDotSize: 2, crosshairOutline: false,
    autoBhop: false, superBhop: false, superBhopSpeedPercent: 250,
    autoStrafe: false, strafeMode: 'wasd',
    bhopNoStamina: false, autoLandingHop: false,
    strafeCustomSpeed: false, strafeSpeedPercent: 100, rageSpeedPercent: 100,
    rageBot: false, rageFullMapWallbang: false,
    rageDamageBoost: false, rageDamagePercent: 150,
    rageMinDamage: 1,
    noSpread: false, noRecoil: false, infiniteAmmo: false, lethalShots: false,
    triggerBot: false, triggerRadius: 8,
    autoReload: false, autoReloadThreshold: 0,
    rageAutoFire: true, rageFov: 180,
    fastPlant: false, fastDefuse: false, infiniteMoney: false,
    buyAnywhere: false, buyAnytime: false,
    skinChanger: false, skinCurrentMode: 'native', skinEditorTarget: 'knife',
    skinKnifeModel: 'native',
    skinKnifeFinish: 'native', skinKnifeTextureUrl: '',
    skinWeaponFinish: 'native', skinWeaponTextureUrl: '',
    skinPerWeaponTextures: false, skinWeaponProfiles: {},
    skinProfileWeapon: 'awp', skinProfileFinish: 'fade', skinProfileUrl: '',
    gunModifierEnabled: false, gunModifierProfiles: {}, gunEditorWeapon: 'awp',
    gunEditorX: 0, gunEditorY: 0, gunEditorZ: 0,
    gunEditorDamage: 100, gunEditorSpread: 100, gunEditorRecoil: 100,
    gunEditorFireRate: 100, gunEditorPenetration: 100,
    infiniteCredits: false, economyHud: false,
    autoBuyEnabled: false, autoBuyPreset: 'full', autoBuyArmor: true,
    autoBuyKit: false, autoBuyGrenades: true,
    autoBuyFlash: 1, autoBuyHE: 1, autoBuySmoke: 1,
  };
  const colorKeys = new Set([
    'espEnemyColor',
    'espTeamColor',
    'silentCircleColor', 'crosshairColor',
    'boxVisibleColor','boxHiddenColor','boxTeamColor','boxFillColor'
  ]);

  let saved = {};
  try {
    saved = JSON.parse(localStorage.getItem(KEY) || '{}');
  } catch {}

  const cfg = Object.fromEntries(Object.keys(defaults).map(key => {
    const fallback = defaults[key];
    const value = saved[key];
    const validPosition = (key === 'x' || key === 'y') &&
      (value === null || (typeof value === 'number' && Number.isFinite(value)));
    const validValue = value != null && typeof value === typeof fallback &&
      (typeof value !== 'number' || Number.isFinite(value)) &&
      (!colorKeys.has(key) || /^#[0-9a-f]{6}$/i.test(value)) &&
      (!['skinWeaponProfiles','gunModifierProfiles'].includes(key)||!Array.isArray(value));
    return [key, validPosition || validValue ? value : fallback];
  }));
  const removedFeatureFlags = ["vmChams","gunModifierEnabled"];
  for (const key of removedFeatureFlags) if (key in cfg) cfg[key] = false;
  const tabs = ['Legit','Rage','Visuals','Movement','Misc','Skins','Settings'];

  if (!tabs.includes(cfg.tab)) cfg.tab = 'Visuals';

  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify(cfg));
    } catch {}
  };

  const configKeys = Object.keys(defaults).filter(key =>
    !['x','y','tab'].includes(key)
  );

  const configEnums = {
    tab: tabs, strafeMode: ['wasd','legit','rage'],
    funEmote: ['flashed','flashed_crouch','knife_swing','knife_stab',
      'throw_underhand','throw_overhand','plant_crouch','death_chest_a',
      'death_gut_a','breathing'],
    funMapPreset: ['flat','arena','sky','parkour','pillars','custom'],
    gunEditorWeapon: SKIN_FIREARM_IDS,
    skinCurrentMode: ['native','default'], skinEditorTarget: ['knife','global','profile'],
    skinKnifeModel: ['native','default',...SKIN_KNIFE_MODELS],
    skinKnifeFinish: ['native','crimson','emerald','sapphire','gold','carbon',
      'fade','neon','ice','obsidian','tiger','damascus','digital','galaxy',
      'toxic','lava','arctic','sunset','ruby','amethyst','cobalt','jade',
      'pearl','holographic','circuit','woodland','desert','ocean','bloodmoon',
      'monochrome','lightning','graffiti','checker','rainbow','custom'],
    skinWeaponFinish: ['native','crimson','emerald','sapphire','gold','carbon',
      'fade','neon','ice','obsidian','tiger','damascus','digital','galaxy',
      'toxic','lava','arctic','sunset','ruby','amethyst','cobalt','jade',
      'pearl','holographic','circuit','woodland','desert','ocean','bloodmoon',
      'monochrome','lightning','graffiti','checker','rainbow','custom'],
    skinProfileWeapon: SKIN_FIREARM_IDS,
    skinProfileFinish: ['native','crimson','emerald','sapphire','gold','carbon',
      'fade','neon','ice','obsidian','tiger','damascus','digital','galaxy',
      'toxic','lava','arctic','sunset','ruby','amethyst','cobalt','jade',
      'pearl','holographic','circuit','woodland','desert','ocean','bloodmoon',
      'monochrome','lightning','graffiti','checker','rainbow','custom'],
    autoBuyPreset: ['off','full','rifle','smg','sniper','pistol','armor'],
  };
  const configRanges = {
    silentFov:[20,500],
    triggerDelayMs:[0,500],
    triggerRadius:[2,40], autoReloadThreshold:[0,15],
    superBhopSpeedPercent:[100,500],
    strafeSpeedPercent:[50,1000], rageSpeedPercent:[50,1000],
    rageFov:[1,180],
    silentCircleOpacity:[10,100], silentCircleWidth:[0.5,5],
    crosshairSize:[2,30], crosshairGap:[0,20], crosshairWidth:[1,6],
    crosshairDotSize:[1,6],
    boxFillOpacity:[1,50], headDotSize:[1,8],
    espMaxDistance:[0,300], espOpacity:[10,100], boxThickness:[0.5,6],
    gunEditorX:[-5,5],gunEditorY:[-5,5],gunEditorZ:[-5,5],
    gunEditorDamage:[0,1000],gunEditorSpread:[0,500],gunEditorRecoil:[0,500],
    gunEditorFireRate:[10,1000],gunEditorPenetration:[0,1000],
    rageDamagePercent:[10,500], rageMinDamage:[1,200],
    autoBuyFlash:[0,4], autoBuyHE:[0,4], autoBuySmoke:[0,4]
  };

  function parseConfig(text) {
    const data = JSON.parse(text.replace(/^\uFEFF/, ''));
    if (!data || typeof data !== 'object' || Array.isArray(data)) throw Error('Config must contain a settings object.');
    if (data.format !== undefined && !['amnesis','silly-v2'].includes(data.format)) throw Error('Unsupported config format.');
    if (data.version !== undefined && ['amnesis','silly-v2'].includes(data.format) && data.version !== 1) throw Error('Unsupported config version.');
    const settings = data.settings ?? data;
    if (!settings || typeof settings !== 'object' || Array.isArray(settings)) throw Error('Missing settings object.');
    const result = {};
    for (const key of configKeys) {
      if (!Object.prototype.hasOwnProperty.call(settings, key)) continue;
      const value = settings[key];
      if (key === 'x' || key === 'y') {
        if (value !== null && (typeof value !== 'number' || !Number.isFinite(value))) throw Error('Invalid ' + key);
      } else if (typeof value !== typeof defaults[key]) throw Error('Invalid type for ' + key);
      if (['skinWeaponProfiles','gunModifierProfiles'].includes(key)&&Array.isArray(value))
        throw Error('Invalid weapon profiles.');
      if (typeof value === 'number' && !Number.isFinite(value)) throw Error('Invalid number for ' + key);
      if (configEnums[key] && !configEnums[key].includes(value)) throw Error('Invalid option for ' + key);
      if (colorKeys.has(key) &&
          !/^#[0-9a-f]{6}$/i.test(value)) throw Error('Invalid color for ' + key);
      if (configRanges[key] && (value < configRanges[key][0] || value > configRanges[key][1])) throw Error('Out-of-range value for ' + key);
      result[key] = value;
    }
    if (!Object.keys(result).length) throw Error('No recognized settings found.');
    return result;
  }

  function exportConfig() {
    const settings = Object.fromEntries(configKeys.map(key => [key, cfg[key]]));
    const blob = new Blob([JSON.stringify({format:'amnesis', version:1, settings}, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'RawS Client.cfg';
    document.body.append(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function configControls() {
    const panel = section('Configs', 'Import or export module settings and colors as a .cfg file. Imports apply immediately. Missing settings keep their current values.');
    const message = elem('p', 'note');
    message.setAttribute('role', 'status');
    const exportButton = elem('button', 'action', 'Export .cfg');
    exportButton.onclick = exportConfig;
    const importButton = elem('button', 'action', 'Import .cfg');
    const picker = elem('input');
    picker.type = 'file';
    picker.accept = '.cfg,application/json';
    picker.hidden = true;
    importButton.onclick = () => picker.click();
    picker.onchange = async () => {
      const file = picker.files?.[0];
      if (!file) return;
      try {
        if (file.size > 128 * 1024) throw Error('Config exceeds 128 KB.');
        const settings = parseConfig(await file.text());
        Object.assign(cfg, settings);
        save();
        box.style.setProperty('--accent', UI_ACCENT);
        renderNav();
        renderPage();
        const notice = elem('p', 'note', 'Imported ' + file.name + ' (' + Object.keys(settings).length + ' settings).');
        notice.setAttribute('role', 'status');
        page.prepend(notice);
      } catch (error) {
        message.textContent = 'Import failed: ' + error.message;
      } finally { picker.value = ''; }
    };
    panel.append(exportButton, importButton, picker, message);
  }

  const norm = s => String(s || '').toLowerCase().trim().replace(/^weapon_/, '');
  const titlecase = s => String(s || '').replace(/[_-]/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

  const knifeRE = /knife|bayonet|karambit|dagger|falchion|bowie|huntsman|navaja|nomad|paracord|skeleton|stiletto|survival|talon|ursus|kukri/i;
  const isKnife = s => knifeRE.test(norm(s));
  let uiOpen = false;
  let root, box, nav, page, pageBody, sectionList, contextPanel;
  let lockEl, hadLock = false, drag = null;
  const activeSectionByTab=new Map();

  // Runtime references for the visual / economy modules.
  let economyHudEl=null;
  const INV_KEY='clutcher_inv_v1';
  const VIRTUAL_CREDITS=999999999;
  let creditsVirtualized=false, creditsStorageOriginals=null;

  // =====================================================

  // =====================================================
  // LOCAL SKIN TEXTURE SUPPORT
  // =====================================================
  // Only traverse the local first-person viewmodel scene. Never alter
  // game.scene materials, enemy entities, or shared source materials.
  function loadTextureFile(file,kind) {
    return new Promise((resolve,reject)=>{
      if (!file||file.size>16*1024*1024) return reject(Error('Image must be under 16 MB.'));
      if (!file.type.startsWith('image/')&&!/\.(png|jpe?g|webp)$/i.test(file.name))
        return reject(Error('Choose a PNG, JPG, or WebP image.'));
      const url=URL.createObjectURL(file),image=new Image();
      image.onload=()=>{
        URL.revokeObjectURL(url);
        if(kind==='knife'){uploadedKnifeTextureImage=image;uploadedKnifeTextureName=file.name;}
        else if(String(kind).startsWith('weapon:'))
          uploadedWeaponProfileImages.set(String(kind).slice(7),{image,name:file.name});
        else{uploadedWeaponTextureImage=image;uploadedWeaponTextureName=file.name;}
        knifeTextureVersion++;resolve(image);
      };
      image.onerror=()=>{URL.revokeObjectURL(url);reject(Error('Could not decode image.'));};
      image.src=url;
    });
  }

  function builtInKnifeFinish(name) {
    if (knifeFinishImages.has(name)) return knifeFinishImages.get(name);
    const canvas=document.createElement('canvas');canvas.width=canvas.height=512;
    const c=canvas.getContext('2d');
    const gradients={
      crimson:['#170307','#7d0c1b','#ff334d'],emerald:['#02140d','#087846','#5dffb0'],
      sapphire:['#030b1d','#124fa5','#63bdff'],gold:['#241500','#a76b08','#ffe58a'],
      fade:['#ff58c8','#745cff','#48d9ff'],ice:['#dffaff','#6bdcff','#ffffff'],
      obsidian:['#020204','#171022','#5c2d78'],toxic:['#071400','#48c000','#d7ff32'],
      lava:['#120000','#d62b00','#ffd04d'],arctic:['#071728','#5dbfe8','#eaffff'],
      sunset:['#301047','#f23f74','#ffbd5b'],galaxy:['#050018','#391b70','#d458ff'],
      ruby:['#250006','#a00020','#ff6077'],amethyst:['#10001e','#7020a0','#db8cff'],
      cobalt:['#010d28','#144fbd','#72a8ff'],jade:['#001b13','#098661','#7affc5'],
      pearl:['#777b86','#fffdf2','#b5c7dd'],holographic:['#ff62b7','#67f5ff','#ceff70','#aa71ff'],
      ocean:['#001224','#006c8c','#55e7e0'],bloodmoon:['#080000','#6d0000','#ff3b21'],
      monochrome:['#050505','#777','#f5f5f5'],rainbow:['#ff3434','#ffdf38','#35f079','#34bfff','#984cff','#ff4fc5']
    };
    if (name==='carbon') {
      c.fillStyle='#111';c.fillRect(0,0,512,512);
      for(let y=0;y<512;y+=32)for(let x=0;x<512;x+=32){
        c.fillStyle=(x/32+y/32)%2?'#262626':'#090909';c.fillRect(x,y,30,30);
      }
    } else if (name==='neon') {
      c.fillStyle='#020205';c.fillRect(0,0,512,512);
      c.lineWidth=8;
      for(let i=-512;i<1024;i+=52){
        c.strokeStyle=i%104?'#ff1f78':'#21e6ff';c.beginPath();
        c.moveTo(i,0);c.lineTo(i-512,512);c.stroke();
      }
    } else if (name==='tiger') {
      c.fillStyle='#d96a00';c.fillRect(0,0,512,512);c.strokeStyle='#17100a';c.lineWidth=22;
      for(let i=-400;i<900;i+=70){c.beginPath();c.moveTo(i,0);c.bezierCurveTo(i+130,150,i-80,350,i+80,512);c.stroke();}
    } else if (name==='damascus') {
      c.fillStyle='#59626b';c.fillRect(0,0,512,512);
      for(let y=0;y<512;y+=12){c.strokeStyle=y%24?'#c7d0d5':'#252b30';c.beginPath();
        for(let x=0;x<=512;x+=8){const py=y+Math.sin(x/24+y/31)*9;x?c.lineTo(x,py):c.moveTo(x,py);}c.stroke();}
    } else if (name==='digital') {
      c.fillStyle='#18231c';c.fillRect(0,0,512,512);
      let seed=1337;for(let y=0;y<512;y+=16)for(let x=0;x<512;x+=16){
        seed=(seed*1664525+1013904223)>>>0;c.fillStyle=['#233a2a','#47604a','#75816f','#111915'][seed%4];
        c.fillRect(x,y,16*(1+(seed>>3)%3),16);
      }
    } else if (name==='galaxy') {
      const gradient=c.createRadialGradient(180,220,10,256,256,430);
      gradient.addColorStop(0,'#db4fff');gradient.addColorStop(.35,'#442080');gradient.addColorStop(1,'#02000d');
      c.fillStyle=gradient;c.fillRect(0,0,512,512);
      let seed=42;for(let i=0;i<180;i++){seed=(seed*1103515245+12345)>>>0;
        const x=seed%512;seed=(seed*1103515245+12345)>>>0;const y=seed%512;
        c.fillStyle='#fff';c.globalAlpha=.3+(seed%70)/100;c.fillRect(x,y,1+(seed%3),1+(seed%3));}
      c.globalAlpha=1;
    } else if (name==='circuit') {
      c.fillStyle='#06110d';c.fillRect(0,0,512,512);c.strokeStyle='#28f59a';c.lineWidth=4;
      for(let y=28;y<512;y+=52){c.beginPath();c.moveTo(0,y);c.lineTo(110,y);
        c.lineTo(140,y+22);c.lineTo(290,y+22);c.lineTo(320,y);c.lineTo(512,y);c.stroke();}
      c.fillStyle='#b6ffe2';for(let y=28;y<512;y+=52)for(let x=32;x<512;x+=128)c.fillRect(x,y-5,10,10);
    } else if (name==='woodland'||name==='desert') {
      const palette=name==='woodland'?['#10180e','#304126','#596044','#1d2618']:
        ['#49351f','#96724a','#cfad72','#665037'];
      c.fillStyle=palette[0];c.fillRect(0,0,512,512);let seed=name==='woodland'?77:91;
      for(let i=0;i<180;i++){seed=(seed*1664525+1013904223)>>>0;
        const x=seed%512;seed=(seed*1664525+1013904223)>>>0;const y=seed%512;
        c.fillStyle=palette[(seed>>5)%palette.length];c.beginPath();
        c.ellipse(x,y,18+(seed%55),10+((seed>>7)%32),(seed%628)/100,0,Math.PI*2);c.fill();}
    } else if (name==='lightning') {
      c.fillStyle='#020817';c.fillRect(0,0,512,512);c.strokeStyle='#8cecff';c.lineWidth=9;
      c.shadowColor='#30bfff';c.shadowBlur=22;
      for(let x=40;x<520;x+=105){c.beginPath();c.moveTo(x,0);let px=x;
        for(let y=0;y<540;y+=55){px+=((x+y)%3-1)*32;c.lineTo(px,y);}c.stroke();}
      c.shadowBlur=0;
    } else if (name==='graffiti') {
      c.fillStyle='#171717';c.fillRect(0,0,512,512);
      const colors=['#ff275d','#ffe22f','#22e6ff','#8aff42','#a95cff'];
      c.lineWidth=14;c.lineCap='round';
      for(let i=0;i<24;i++){c.strokeStyle=colors[i%colors.length];c.beginPath();
        c.moveTo((i*83)%512,(i*47)%512);c.quadraticCurveTo((i*137)%512,(i*199)%512,(i*239)%512,(i*71)%512);c.stroke();}
    } else if (name==='checker') {
      for(let y=0;y<512;y+=48)for(let x=0;x<512;x+=48){
        c.fillStyle=((x/48+y/48)%2)?'#e6e6e6':'#161616';c.fillRect(x,y,48,48);}
    } else {
      const colors=gradients[name]||['#444','#aaa','#fff'];
      const gradient=c.createLinearGradient(0,512,512,0);
      colors.forEach((color,index)=>gradient.addColorStop(index/(colors.length-1),color));
      c.fillStyle=gradient;c.fillRect(0,0,512,512);
      c.globalAlpha=.18;c.fillStyle='#fff';
      for(let i=0;i<18;i++)c.fillRect(-200+i*55,0,18,720);
      c.globalAlpha=1;
    }
    knifeFinishImages.set(name,canvas);return canvas;
  }

  const skinWeaponAliases={usp:'usps',hkp2000:'p2000',elite:'dualies',
    cz75a:'cz75',revolver:'r8',galilar:'galil'};
  const normalizeSkinWeapon=id=>skinWeaponAliases[norm(id)]||norm(id);

  function resolveSkinIntent(g) {
    const weaponId=normalizeSkinWeapon(g?.weapons?.current);
    const weaponClass=g?.weapons?.def?.()?.class;
    if(!cfg.skinChanger) return {enabled:false,weaponId,weaponClass};
    if(weaponClass==='knife'||weaponId==='knife') {
      const finish=cfg.skinKnifeFinish;
      return {enabled:finish!=='native',scope:'knife',weaponId,weaponClass,finish,
        url:String(cfg.skinKnifeTextureUrl||'').trim(),upload:uploadedKnifeTextureImage};
    }
    if(!['pistol','rifle','smg','shotgun','sniper','mg'].includes(weaponClass))
      return {enabled:false,weaponId,weaponClass};
    const rawProfiles=cfg.skinWeaponProfiles||{};
    const profile=cfg.skinPerWeaponTextures?
      (rawProfiles[weaponId]||rawProfiles[g?.weapons?.current]):null;
    const scope=cfg.skinPerWeaponTextures?'profile':'global';
    const finish=scope==='profile'?(profile?.finish||'native'):cfg.skinWeaponFinish;
    const upload=scope==='profile'?uploadedWeaponProfileImages.get(weaponId)?.image:
      uploadedWeaponTextureImage;
    const url=scope==='profile'?String(profile?.url||'').trim():
      String(cfg.skinWeaponTextureUrl||'').trim();
    return {enabled:finish!=='native',scope,weaponId,weaponClass,finish,url,upload};
  }

  function resolveSkinIntentImage(intent) {
    if(!intent?.enabled||intent.finish==='native') return null;
    if(intent.finish!=='custom') return builtInKnifeFinish(intent.finish);
    if(intent.upload) return intent.upload;
    const url=intent.url;
    if(!url) return null;
    const knife=intent.scope==='knife';
    if(knife){
      if(url!==customKnifeUrl&&!customKnifeLoading){
        customKnifeUrl=url;customKnifeImage=null;customKnifeLoading=true;
        const image=new Image();image.crossOrigin='anonymous';
        image.onload=()=>{if(customKnifeUrl===url){customKnifeImage=image;knifeTextureVersion++;}
          customKnifeLoading=false;};
