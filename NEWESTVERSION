  const rageProbeCache=new WeakMap();

  function rageBulletPath(g, origin, p, enemy) {
    const vx = p.x-origin.x, vy = p.y-origin.y, vz = p.z-origin.z;
    const dist = Math.hypot(vx,vy,vz);
    if (!(dist > 0.0001) || !Number.isFinite(dist)) return null;
    const physics = g.physics;
    const dx=vx/dist, dy=vy/dist, dz=vz/dist;
    const weapon=g.weapons?.def?.();
    if (!weapon) return null;

    if (cfg.rageFullMapWallbang) {
      let blocked=false;
      try {
        const hit=physics?.raycast?.(origin.x,origin.y,origin.z,
          dx,dy,dz,Math.max(0,dist-.003),2);
        blocked=!!hit;
      } catch {}
      return {mode:blocked?'wallbang':'clear',walls:blocked?1:0,
        damageScale:1,pathDamage:Number(weapon.dmg)||1,bypassWorld:blocked};
    }

    const Ctor=g._bulletPath?.constructor;
    if (typeof Ctor!=='function'||typeof Ctor.prototype?.trace!=='function'||
        typeof g._hitboxIntervals!=='function') {
      try {
        return physics?.lineClear?.(origin.x,origin.y,origin.z,p.x,p.y,p.z)
          ? {mode:'clear',walls:0,damageScale:1,pathDamage:Number(weapon.dmg)||1}
          : null;
      } catch {return null;}
    }

    let cached=rageProbeCache.get(g);
    if (!cached||cached.Ctor!==Ctor) {
      cached={Ctor,probe:new Ctor(physics,g._hitboxIntervals.bind(g))};
      rageProbeCache.set(g,cached);
    }
    const probe=cached.probe;
    probe.phys=physics;
    const hadShooter=Object.prototype.hasOwnProperty.call(g,'_bulletShooter');
    const oldShooter=g._bulletShooter;
    const range=Math.min(300,Number(weapon.maxRange)||300);
    try {
      g._bulletShooter=g.player;
      g._hbSerial=(g._hbSerial|0)+1;
      probe.trace(origin.x,origin.y,origin.z,dx,dy,dz,range,weapon);
    } catch (error) {
      console.warn('[Rage Bot] native path probe:',error);
      return null;
    } finally {
      if (hadShooter) g._bulletShooter=oldShooter;
      else delete g._bulletShooter;
    }

    let solidCount=0,wallCount=0;
    const end=Number(probe.end)||range;
    for (let i=0;i<(probe.segs?.length||0);i++) {
      const seg=probe.segs[i];
      if (seg.solid) {
        const boundary=probe.recs?.[seg.b];
        if (seg.stopped||i===probe.segs.length-1) return null;
        solidCount++;
        if (boundary?.b) wallCount++;
        continue;
      }
      if (seg.t1>=end-1e-6) break;
      const rec=probe.recs?.[seg.b];
      if (!rec||rec.b||!rec.ent) continue;
      if (!g.friendlyFire&&rec.ent.team===g.player.team) return null;
      if (rec.ent===enemy) {
        const damage=Number(seg.dmg)||0;
        if (damage<Math.max(1,Number(cfg.rageMinDamage)||1)) return null;
        return {mode:wallCount?'wallbang':'clear',walls:wallCount,
          solidCount,pathDamage:damage,
          damageScale:damage/Math.max(1,Number(weapon.dmg)||1)};
      }
    }
    return null;
  }

  function rageAimCandidate(g, origin, p, fwd, cosFov, enemy) {
    if (![p.x,p.y,p.z].every(Number.isFinite)) return null;
    const dx=p.x-origin.x, dy=p.y-origin.y, dz=p.z-origin.z;
    const length=Math.hypot(dx,dy,dz);
    if (length<0.05) return null;
    const dir={x:dx/length,y:dy/length,z:dz/length};
    const dot=dir.x*fwd.x+dir.y*fwd.y+dir.z*fwd.z;
    if (dot < cosFov-1e-7) return null;
    const path=rageBulletPath(g,origin,p,enemy);
    if (!path) return null;
    return {
      dir,point:p,length,angle:Math.acos(Math.max(-1,Math.min(1,dot))),
      path
    };
  }

  function rageTarget(g, origin) {
    syncRageLifecycle(g);
    if (!cfg.rageBot || !rageCombatActive(g,false)) return null;
    const local=g.player;
    const pitch=Number(local.pitch), yaw=Number(local.yaw);
    if (!Number.isFinite(pitch)||!Number.isFinite(yaw)) return null;
    const cs=Math.cos(pitch);
    const fwd={x:-Math.sin(yaw)*cs,y:Math.sin(pitch),z:-Math.cos(yaw)*cs};
    const fov=Math.max(1,Math.min(180,Number(cfg.rageFov)||180));
    const cosFov=Math.cos(fov*Math.PI/180);
    const entities=characterEntities(g);
    let chosen=null, bestKey=null;
    const betterKey=(a,b)=>!b||a.some((value,index)=>
      value!==b[index]&&a.slice(0,index).every((v,i)=>v===b[i])&&value<b[index]
    );

    for (const enemy of entities) {
      if (!enemy || enemy===local || !enemy.alive ||
          (local.team!=null && enemy.team===local.team) ||
          Number(enemy.spawnProt)>0) continue;
      if (![enemy.x,enemy.y,enemy.z].every(Number.isFinite)) continue;

      const ey=Number(enemy._visY ?? enemy.y);
      const height=Number(enemy.height)||1.8;
      const point={x:Number(enemy.x),y:ey+height*.65,z:Number(enemy.z)};
      const candidate=rageAimCandidate(g,origin,point,fwd,cosFov,enemy);
      if (!candidate) continue;
      // Preserve visible-enemy priority for clear paths over wallbang paths.
      const modeRank={clear:0,wallbang:1}[candidate.path.mode];
      const key=[modeRank,candidate.angle,candidate.length];
      if (betterKey(key,bestKey)) {
        bestKey=key;
        chosen={enemy,...candidate};
      }
    }
    return chosen;
  }

