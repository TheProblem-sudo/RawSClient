// ==UserScript==
// @name         RawSClient Loader
// @namespace    https://github.com/TheProblem-sudo/RawSClient
// @version      2.3.2
// @description  Device-first RawSClient loader with update checks.
// @match        https://www.clutcher.io/*
// @match        https://clutcher.io/*
// @match        file:///*/Clutcher-Offline.html
// @run-at       document-end
// @grant        none
// ==/UserScript==

(() => {
  'use strict';
  const LOADER_VERSION = '2.3.2';
  const RAW = 'https://raw.githubusercontent.com/TheProblem-sudo/RawSClient/main/';
  const MANIFEST_URL = RAW + 'VERSIONS.json';
  const LOADER_URL = RAW + 'Loader';
  const FLAG = '__rawsClientLoaderStarted';
  if (window[FLAG]) return;
  window[FLAG] = true;

  const FALLBACK_BUILDS = {
    PC: {
      previous: { file: 'PREVVERSION', version: '3.5.0', build: 'PC Previous' },
      newest: { file: 'NEWESTVERSION', version: '6.0.0', build: 'PC Newest' }
    },
    Mobile: {
      previous: { file: 'PREVVERSIONMOBILE', version: '3.5.0-mobile', build: 'Mobile Previous' },
      newest: { file: 'NEWESTVERSIONMOBILE', version: '6.0.0-mobile', build: 'Mobile Newest' }
    }
  };

  function createLoader() {
    if (!document.body || document.getElementById('raws-client-loader-host')) return;
    const host = document.createElement('div');
    host.id = 'raws-client-loader-host';
    host.style.cssText = 'all:initial;position:fixed;inset:0;z-index:2147483647;pointer-events:none;';
    document.body.appendChild(host);
    const root = host.attachShadow ? host.attachShadow({ mode: 'open' }) : host;

    const style = document.createElement('style');
    style.textContent = `
      *{box-sizing:border-box}
      .backdrop{position:fixed;inset:0;display:grid;place-items:center;padding:12px;background:transparent;pointer-events:none;font-family:Arial,Helvetica,sans-serif;color:#f1fff3}
      .panel{width:min(390px,calc(100vw - 24px));padding:14px;border:1px solid rgba(57,255,20,.32);border-radius:11px;background:rgba(9,15,11,.97);box-shadow:0 8px 30px rgba(0,0,0,.38);pointer-events:auto}
      .heading{text-align:center;margin:0 0 11px;color:#eaffeb;font-size:13px;font-weight:700}
      .choices{display:flex;justify-content:center;flex-wrap:wrap;gap:8px}
      .choices[hidden],.back[hidden]{display:none!important}
      .panel{position:relative;overflow:hidden;animation:panelIn .55s cubic-bezier(.2,.8,.2,1) both;border-color:rgba(57,255,20,.48);background:linear-gradient(145deg,rgba(13,23,15,.98),rgba(5,10,7,.98))}
      .panel:after{content:'';position:absolute;inset:-1px;border-radius:inherit;border:1px solid rgba(57,255,20,.16);pointer-events:none;animation:panelGlow 3.2s ease-in-out infinite}
      .heading{animation:headingIn .45s ease both;text-shadow:0 0 14px rgba(57,255,20,.22)}
      .choices.screen-enter{animation:screenIn .42s cubic-bezier(.2,.8,.2,1) both}
      .choices button{min-width:104px;transition:transform .18s ease,border-color .18s ease,background .18s ease,box-shadow .18s ease}
      .choices button:hover:not(:disabled){transform:translateY(-3px) scale(1.035);box-shadow:0 5px 18px rgba(57,255,20,.16)}
      .choices button:active:not(:disabled){transform:scale(.97)}
      .back{transition:color .18s ease,transform .18s ease}
      .back:hover:not(:disabled){transform:translateY(-1px);color:#39ff14}
      @keyframes panelIn{from{opacity:0;transform:translateY(15px) scale(.96);filter:blur(5px)}to{opacity:1;transform:translateY(0) scale(1);filter:blur(0)}}
      @keyframes screenIn{from{opacity:0;transform:translateY(9px) scale(.98);filter:blur(3px)}to{opacity:1;transform:translateY(0) scale(1);filter:blur(0)}}
      @keyframes headingIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}
      @keyframes panelGlow{0%,100%{opacity:.25}50%{opacity:.8}}
      @media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
      button{min-height:34px;padding:7px 13px;border:1px solid #304136;border-radius:7px;background:#151f18;color:#f3fff4;font-size:12px;font-weight:700;cursor:pointer}
      button:hover:not(:disabled){border-color:#39ff14;background:#1b2b1d}
      button:focus-visible{outline:2px solid #39ff14;outline-offset:2px}
      button:disabled{opacity:.55;cursor:wait}
      .back{display:block;margin:10px auto 0;background:transparent;border-color:#26352b;color:#b9c9bc}
      .update{display:none;margin:0 0 10px;padding:9px;border:1px solid rgba(255,190,70,.4);border-radius:8px;background:rgba(100,67,15,.2);text-align:center}
      .update strong{display:block;color:#ffdb91;font-size:12px;margin-bottom:4px}
      .update small{display:block;color:#c9b991;font-size:10px;line-height:1.4;margin-bottom:7px}
      .update button{min-height:29px;padding:5px 10px;border-color:#8c6b31;background:#3a2b12;color:#ffe4ad}
      .changelog-toggle{display:block;margin:10px auto 0;min-height:28px;padding:5px 10px;background:transparent;border-color:#26352b;color:#b9c9bc;font-size:11px}
      .changelog{margin-top:8px;padding:9px 10px;border:1px solid rgba(57,255,20,.2);border-radius:7px;background:rgba(20,35,23,.55);color:#c8d8ca;font-size:10px;line-height:1.55}
      .changelog[hidden]{display:none!important}
      .changelog strong{color:#eaffeb}
      .progress{height:5px;margin-top:10px;overflow:hidden;border-radius:8px;background:#1c2a20}
      .progress[hidden]{display:none!important}
      .progress-fill{height:100%;width:0;border-radius:8px;background:linear-gradient(90deg,#168b13,#69ff45);box-shadow:0 0 10px rgba(57,255,20,.5);transition:width .25s ease}
      .remembered{border-color:rgba(57,255,20,.7)!important;box-shadow:inset 0 0 0 1px rgba(57,255,20,.13)}
      .pc-note{margin:0 0 10px;padding:8px 10px;border:1px solid rgba(57,255,20,.35);border-radius:7px;background:rgba(20,35,23,.55);color:#caffc2;font-size:11px;font-weight:700;text-align:center;letter-spacing:.2px}
      .pc-note[hidden]{display:none!important}
      .status{min-height:15px;margin-top:9px;color:#9caf9f;font-size:11px;line-height:1.35;overflow-wrap:anywhere;text-align:center}
      .status.error{color:#ff8585}
      .brand{position:fixed;right:9px;bottom:7px;color:rgba(220,235,222,.55);font-size:10px;font-weight:700;letter-spacing:.7px;text-shadow:0 1px 3px #000;pointer-events:none}
      @media(max-width:360px){.panel{padding:11px}.choices{gap:6px}button{padding:7px 10px}}
    `;
    const backdrop = document.createElement('div');
    backdrop.className = 'backdrop';
    backdrop.innerHTML = `
      <section class="panel" role="dialog" aria-modal="true" aria-label="RawSClient Loader">
        <h2 class="heading">Choose your device</h2>
        <div class="update" aria-live="polite">
          <strong>Loader update available!</strong>
          <small class="update-text"></small>
          <button type="button" data-update>Install Loader Update</button>
        </div>
        <div class="choices" data-screen="device">
          <button type="button" data-device="PC">PC</button>
          <button type="button" data-device="Mobile">Mobile</button>
        </div>
        <div class="pc-note" data-pc-note hidden>To Open GUI Press Right Shift!</div>
        <div class="choices" data-screen="version" hidden>
          <button type="button" data-version="previous">Previous</button>
          <button type="button" data-version="newest">Newest</button>
        </div>
        <button type="button" class="back" data-back hidden>← Back</button>
        <button type="button" class="changelog-toggle" data-changelog-toggle>What's New · v2.3.1</button>
        <div class="changelog" data-changelog hidden><strong>RawSClient Loader 2.3.1</strong><br>• Added remembered device and build selection<br>• Added loading stages and progress indicator<br>• Added SHA-256 integrity verification<br>• Added this changelog panel</div>
        <div class="progress" data-progress hidden><div class="progress-fill" data-progress-fill></div></div>
        <div class="status" role="status" aria-live="polite">Checking for updates…</div>
      </section>
      <div class="brand">RawSLoader</div>
    `;
    root.append(style, backdrop);

    const heading = root.querySelector('.heading');
    const deviceScreen = root.querySelector('[data-screen="device"]');
    const versionScreen = root.querySelector('[data-screen="version"]');
    const back = root.querySelector('[data-back]');
    const pcNote = root.querySelector('[data-pc-note]');
    const status = root.querySelector('.status');
    const progress = root.querySelector('[data-progress]');
    const progressFill = root.querySelector('[data-progress-fill]');
    const changelogToggle = root.querySelector('[data-changelog-toggle]');
    const changelog = root.querySelector('[data-changelog]');
    const STORAGE_KEY = 'rawsclient-loader-preferences-v1';
    function readPreferences() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {}; }
      catch (_) { return {}; }
    }
    function savePreferences(patch) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...readPreferences(), ...patch })); }
      catch (_) { /* Storage may be disabled; loading still works. */ }
    }
    const savedPreferences = readPreferences();
    if (savedPreferences.device) { const b = root.querySelector('[data-device="' + savedPreferences.device + '"]'); if (b) b.classList.add('remembered'); }
    if (savedPreferences.version) { const b = root.querySelector('[data-version="' + savedPreferences.version + '"]'); if (b) b.classList.add('remembered'); }
    if (savedPreferences.device || savedPreferences.version) status.textContent = 'Last used: ' + [savedPreferences.device, savedPreferences.version].filter(Boolean).join(' / ') + '. Choose your device to continue.';
    changelogToggle.addEventListener('click', () => { changelog.hidden = !changelog.hidden; changelogToggle.textContent = changelog.hidden ? "What's New · v2.3.1" : 'Hide Changelog'; });
    function setProgress(value, message) { progress.hidden = false; progressFill.style.width = value + '%'; status.textContent = message; }
    const updateBox = root.querySelector('.update');
    const updateText = root.querySelector('.update-text');
    let selectedDevice = null;
    let builds = FALLBACK_BUILDS;

    root.querySelector('[data-update]').addEventListener('click', () => {
      window.open(LOADER_URL, '_blank', 'noopener');
    });

    root.querySelectorAll('[data-device]').forEach(button => {
      button.addEventListener('click', () => {
        selectedDevice = button.dataset.device;
        savePreferences({ device: selectedDevice });
        pcNote.hidden = selectedDevice !== 'PC';
        deviceScreen.hidden = true;
        versionScreen.hidden = false;
        versionScreen.classList.remove('screen-enter');
        void versionScreen.offsetWidth;
        versionScreen.classList.add('screen-enter');
        back.hidden = false;
        heading.textContent = selectedDevice + ' — choose version';
        heading.animate([{opacity:0,transform:'translateY(-5px)'},{opacity:1,transform:'translateY(0)'}],{duration:320,easing:'ease-out'});
        status.classList.remove('error');
        status.textContent = 'Select Previous or Newest.';
      });
    });

    back.addEventListener('click', () => {
      selectedDevice = null;
      pcNote.hidden = true;
      versionScreen.hidden = true;
      deviceScreen.hidden = false;
      deviceScreen.classList.remove('screen-enter');
      void deviceScreen.offsetWidth;
      deviceScreen.classList.add('screen-enter');
      back.hidden = true;
      heading.textContent = 'Choose your device';
      heading.animate([{opacity:0,transform:'translateY(-5px)'},{opacity:1,transform:'translateY(0)'}],{duration:320,easing:'ease-out'});
      status.classList.remove('error');
      status.textContent = 'Select your device.';
    });

    async function checkUpdates() {
      try {
        const response = await fetch(MANIFEST_URL, { cache: 'no-store' });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const manifest = await response.json();
        if (!manifest || !manifest.builds || !manifest.loaderVersion) throw new Error('Invalid version manifest.');
        builds = manifest.builds;
        if (manifest.loaderVersion !== LOADER_VERSION) {
          updateText.textContent = 'Installed: ' + LOADER_VERSION + ' • Latest: ' + manifest.loaderVersion;
          updateBox.style.display = 'block';
          status.textContent = 'A newer Loader is available. You can update or continue.';
        } else {
          status.textContent = 'Loader is up to date (v' + LOADER_VERSION + ').';
        }
      } catch (error) {
        console.warn('[RawSClient Loader] Update check failed:', error);
        status.textContent = 'Could not check updates. You can still load a build.';
      }
    }

    async function loadVersion(key) {
      if (!selectedDevice || window.__rawsClientLoaded) return;
      const selected = builds[selectedDevice]?.[key];
      if (!selected?.file) {
        status.classList.add('error');
        status.textContent = 'This build is missing from the version list.';
        return;
      }
      const buttons = [...root.querySelectorAll('button')];
      buttons.forEach(button => { button.disabled = true; });
      savePreferences({ device: selectedDevice, version: key });
      status.classList.remove('error');
      setProgress(12, 'Connecting to RawSClient repository…');
      try {
        setProgress(24, 'Downloading ' + selected.build + ' v' + selected.version + '…');
        const response = await fetch(RAW + selected.file, { cache: 'no-store' });
        if (!response.ok) throw new Error('Download failed: HTTP ' + response.status);
        const source = await response.text();
        if (!source.trim()) throw new Error('The downloaded file is empty.');
        setProgress(68, 'Verifying SHA-256 integrity…');
        if (!selected.sha256 || !/^[a-f0-9]{64}$/i.test(selected.sha256)) throw new Error('No valid SHA-256 checksum is available for this build.');
        if (!window.crypto?.subtle || !window.TextEncoder) throw new Error('This browser does not support secure SHA-256 verification.');
        const digest = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(source));
        const actualHash = Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
        if (actualHash.toLowerCase() !== selected.sha256.toLowerCase()) throw new Error('SHA-256 verification failed. The downloaded file may be corrupted or modified.');
        if (!source.includes('__rawsClientGUI')) throw new Error('The selected file is not a valid RawSClient build.');
        setProgress(92, 'Integrity verified. Starting ' + selected.build + '…');
        (0, eval)(source);
        window.__rawsClientLoaded = selectedDevice.toLowerCase() + '-' + key;
        progressFill.style.width = '100%';
        status.textContent = selected.build + ' loaded successfully. SHA-256 verified.';
        backdrop.style.display = 'none';
      } catch (error) {
        console.error('[RawSClient Loader]', error);
        status.classList.add('error');
        progress.hidden = true;
        progressFill.style.width = '0';
        status.textContent = 'Could not load ' + selected.build + ': ' + (error?.message || String(error));
        buttons.forEach(button => { button.disabled = false; });
      }
    }

    root.querySelectorAll('[data-version]').forEach(button => {
      button.addEventListener('click', () => loadVersion(button.dataset.version));
    });
    checkUpdates();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', createLoader, { once: true });
  } else createLoader();
})();
