// ==UserScript==
// @name         RawSClient Loader
// @namespace    https://github.com/TheProblem-sudo/RawSClient
// @version      1.0.0
// @description  Choose between the previous and newest RawSClient version.
// @match        https://www.clutcher.io/*
// @match        https://clutcher.io/*
// @match        file:///*/Clutcher-Offline.html
// @run-at       document-end
// @grant        none
// ==/UserScript==

(() => {
  'use strict';

  const FLAG = '__rawsClientLoaderStarted';
  if (window[FLAG]) return;
  window[FLAG] = true;

  const VERSIONS = {
    previous: {
      label: 'Prev Version',
      version: '3.5.0',
      url: 'https://raw.githubusercontent.com/TheProblem-sudo/RawSClient/main/PREVVERSION'
    },
    newest: {
      label: 'Newest',
      version: '6.0.0',
      url: 'https://raw.githubusercontent.com/TheProblem-sudo/RawSClient/main/NEWESTVERSION'
    }
  };

  function createLoader() {
    if (!document.body || document.getElementById('raws-client-loader-host')) return;

    const host = document.createElement('div');
    host.id = 'raws-client-loader-host';
    host.style.cssText = 'all:initial;position:fixed;inset:0;z-index:2147483647;pointer-events:none;';
    document.body.appendChild(host);

    const root = host.attachShadow ? host.attachShadow({ mode: 'open' }) : host;
    const style = document.createElement('style');
    style.textContent = `
      * { box-sizing: border-box; }
      .backdrop { position:fixed; inset:0; display:grid; place-items:center; padding:18px;
        background:rgba(3,7,5,.76); backdrop-filter:blur(8px); pointer-events:auto;
        font-family:Arial,Helvetica,sans-serif; color:#f1fff3; }
      .panel { width:min(430px,100%); padding:28px; border:1px solid rgba(57,255,20,.35);
        border-radius:18px; background:linear-gradient(145deg,#111914,#080d0a);
        box-shadow:0 20px 80px rgba(0,0,0,.55),0 0 35px rgba(57,255,20,.08); }
      .eyebrow { color:#39ff14; font-size:11px; font-weight:800; letter-spacing:2.5px; }
      h1 { margin:9px 0 6px; font-size:25px; letter-spacing:.2px; }
      .sub { margin:0 0 23px; color:#aab8ad; font-size:13px; line-height:1.5; }
      .choices { display:grid; gap:11px; }
      button { width:100%; min-height:64px; display:flex; align-items:center; justify-content:space-between;
        gap:12px; padding:13px 16px; border:1px solid #304136; border-radius:12px;
        background:#151f18; color:#f3fff4; text-align:left; cursor:pointer; transition:.18s ease; }
      button:hover:not(:disabled) { border-color:#39ff14; background:#1b2b1d; transform:translateY(-1px); }
      button:focus-visible { outline:2px solid #39ff14; outline-offset:3px; }
      button:disabled { opacity:.55; cursor:wait; }
      .name { display:block; font-size:15px; font-weight:800; }
      .version { display:block; margin-top:5px; color:#8da192; font-size:11px; }
      .arrow { color:#39ff14; font-size:22px; }
      .status { min-height:18px; margin:17px 1px 0; color:#9caf9f; font-size:12px; line-height:1.5; }
      .status.error { color:#ff8585; }
      .foot { margin-top:17px; color:#65756a; font-size:10px; text-align:center; }
      @media (max-width:420px) { .panel { padding:22px; } h1 { font-size:22px; } }
    `;

    const backdrop = document.createElement('div');
    backdrop.className = 'backdrop';
    backdrop.innerHTML = `
      <section class="panel" role="dialog" aria-modal="true" aria-labelledby="rcl-title">
        <div class="eyebrow">RAW S CLIENT</div>
        <h1 id="rcl-title">Choose your version</h1>
        <p class="sub">Select which RawSClient build you want to load.</p>
        <div class="choices">
          <button type="button" data-version="previous">
            <span><span class="name">Prev Version</span><span class="version">RawSClient v3.5.0</span></span>
            <span class="arrow" aria-hidden="true">›</span>
          </button>
          <button type="button" data-version="newest">
            <span><span class="name">Newest</span><span class="version">RawSClient v6.0.0</span></span>
            <span class="arrow" aria-hidden="true">›</span>
          </button>
        </div>
        <div class="status" role="status" aria-live="polite">Ready. Choose a version to continue.</div>
        <div class="foot">Downloads directly from the RawSClient GitHub repository</div>
      </section>
    `;

    root.append(style, backdrop);
    const status = root.querySelector('.status');
    const buttons = [...root.querySelectorAll('button[data-version]')];

    async function loadVersion(key) {
      const selected = VERSIONS[key];
      if (!selected || window.__rawsClientLoaded) return;

      buttons.forEach(button => { button.disabled = true; });
      status.classList.remove('error');
      status.textContent = 'Downloading ' + selected.label + '…';

      try {
        const response = await fetch(selected.url, { cache: 'no-store' });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const source = await response.text();
        if (!source.trim()) throw new Error('The downloaded file is empty.');
        if (!source.includes('__rawsClientGUI')) {
          throw new Error('The selected file does not look like a RawSClient build.');
        }

        status.textContent = 'Starting ' + selected.label + '…';
        (0, eval)(source);
        window.__rawsClientLoaded = key;
        status.textContent = selected.label + ' loaded successfully.';
        backdrop.style.display = 'none';
      } catch (error) {
        console.error('[RawSClient Loader]', error);
        status.classList.add('error');
        status.textContent = 'Could not load ' + selected.label + ': ' + (error && error.message ? error.message : String(error));
        buttons.forEach(button => { button.disabled = false; });
      }
    }

    buttons.forEach(button => {
      button.addEventListener('click', () => loadVersion(button.dataset.version));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', createLoader, { once: true });
  } else {
    createLoader();
  }
})();
