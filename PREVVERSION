// ==UserScript==
// @name         RawS Client (Mobile Friendly)
// @namespace    https://www.clutcher.io/
// @version      3.5.0
// @description  Compact per-weapon gun wraps, knife models/wraps & Silent Aim for Clutcher.io with Mobile Toggle
// @match        https://www.clutcher.io/*
// @match        https://clutcher.io/*
// @match        file:///*/Clutcher-Offline.html
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  'use strict';

  if (window.__rawsClientGUI) return;
  window.__rawsClientGUI = true;

  const characterAgent = entity => entity?.kx7Agent || entity?.cs2Agent;
  const characterEntities = g => {
    const entities = typeof g?.allEntities === 'function' ? [...g.allEntities()] :
      (Array.isArray(g?.botMgr?.bots) ? g.botMgr.bots : Object.values(g?.botMgr?.bots || {}));
    return entities.filter(entity => entity && entity !== g?.player &&
      (entity.team === 'T' || entity.team === 'CT'));
  };

  const titlecase = s => String(s || '').replace(/[_-]/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const KEY = 'raws.client.config.v11';
  
  const SKIN_KNIFE_MODELS = [
    'knife_butterfly',
    'knife_flip',
    'knife_gut',
    'knife_karambit',
    'knife_m9',
    'knife_huntsman'
  ];

  const GAME_GUNS = [
    { id: 'ak47', name: 'AK-47' },
    { id: 'm4a4', name: 'M4A4' },
    { id: 'm4a1', name: 'M4A1-S' },
    { id: 'awp', name: 'AWP' },
    { id: 'galil', name: 'Galil AR' },
    { id: 'famas', name: 'FAMAS' },
    { id: 'mp5', name: 'MP5-SD' },
    { id: 'p90', name: 'P90' },
    { id: 'glock', name: 'Glock-18' },
    { id: 'usp', name: 'USP-S' },
    { id: 'deagle', name: 'Desert Eagle' }
  ];

  const WRAP_FINISHES = [
    'native', 'crimson', 'emerald', 'sapphire', 'gold', 'carbon',
    'fade', 'neon', 'ice', 'obsidian', 'tiger', 'damascus', 'digital', 'galaxy',
    'toxic', 'lava', 'arctic', 'sunset', 'ruby', 'amethyst', 'cobalt', 'jade', 'custom'
  ];

  const defaults = {
    x: null, y: null, tab: 'Skins', skinSubTab: 'Models',
    selectedGun: null,
    accent: '#ff3b4a',
    silentAim: false, silentFov: 120, silentCircle: true,
    silentCircleColor: '#ff3b4a', silentCircleOpacity: 85, silentCircleWidth: 1.25,
    skinChanger: true, skinKnifeModel: 'native', skinKnifeFinish: 'native',
    gunFinishes: {},
    perfSkinScan: true, perfSkinInterval: 150, perfFovRefresh: true,
    mobileBtnX: 20, mobileBtnY: 100
  };

  let saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
  const cfg = Object.fromEntries(Object.keys(defaults).map(k => [k, saved[k] !== undefined ? saved[k] : defaults[k]]));
  if (cfg.skinKnifeModel !== 'native' && !SKIN_KNIFE_MODELS.includes(cfg.skinKnifeModel)) {
    cfg.skinKnifeModel = 'native';
  }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(cfg)); } catch {} };

  let uiOpen = false, root, box, nav, page, pageBody;
  let drag = null, overlay, ctx;
  let hookedGame = null, isUnloaded = false;

  let customKnifeTextureImage = null;
  let customKnifeTextureName = '';
  const customGunTextureImages = new Map();
  const customGunTextureNames = new Map();
  
  let lastObservedWeapon = null;
  let trackedViewmodelScene = null;
  let lastSkinScanAt = 0;
  let lastFovRenderAt = 0;

  function loadTextureFile(file, type = 'knife', gunId = '') {
    return new Promise((resolve, reject) => {
      if (!file || file.size > 16 * 1024 * 1024) return reject(Error('Plik musi mieć poniżej 16 MB.'));
      if (!file.type.startsWith('image/') && !/\.(png|jpe?g|webp)$/i.test(file.name)) return reject(Error('Wybierz obraz PNG, JPG lub WebP.'));
      const url = URL.createObjectURL(file), image = new Image();
      image.onload = () => {
        URL.revokeObjectURL(url);
        if (type === 'gun') {
          customGunTextureImages.set(gunId, image);
          customGunTextureNames.set(gunId, file.name);
        } else {
          customKnifeTextureImage = image;
          customKnifeTextureName = file.name;
        }
        resolve(image);
      };
      image.onerror = () => { URL.revokeObjectURL(url); reject(Error('Nie udało się wczytać obrazu.')); };
      image.src = url;
    });
  }

  // =====================================================
  // SILENT AIM
  // =====================================================
  function mul(m, a) {
    return [
      m[0]*a[0] + m[4]*a[1] + m[8]*a[2] + m[12]*a[3],
      m[1]*a[0] + m[5]*a[1] + m[9]*a[2] + m[13]*a[3],
      m[2]*a[0] + m[6]*a[1] + m[10]*a[2] + m[14]*a[3],
      m[3]*a[0] + m[7]*a[1] + m[11]*a[2] + m[15]*a[3]
    ];
  }

  function point(bone, view, projection, w, h) {
    const m = bone?.matrixWorld?.elements;
    if (!m) return null;
    const eye = mul(view, [m[12], m[13], m[14], 1]);
    const clip = mul(projection, eye);
    if (clip[3] <= 0.001 || clip[2] < -clip[3] || clip[2] > clip[3]) return null;
    const x = (clip[0] / clip[3] * 0.5 + 0.5) * w;
    const y = (0.5 - clip[1] / clip[3] * 0.5) * h;
    return Number.isFinite(x) && Number.isFinite(y) ? [x, y] : null;
  }

  function aimTarget(g, sx, sy, sz) {
    const canvas = g.renderer?.domElement || document.querySelector('#game canvas');
    const camera = g.camera;
    if (!canvas || !camera) return null;

    const rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return null;

    camera.updateMatrixWorld?.(true);
    const view = camera.matrixWorldInverse?.elements;
    const projection = camera.projectionMatrix?.elements;
    if (!view || !projection) return null;

    const centerX = rect.width / 2;
    const centerY = rect.height / 2;
    const radius = Number(cfg.silentFov) || 120;

    let best = null, bestDistance = radius;

    for (const bot of characterEntities(g)) {
      if (!bot?.alive || bot.team === g.player?.team || bot.spawnProt > 0) continue;
      const head = characterAgent(bot)?.bones?.head_0 || characterAgent(bot)?.bones?.head;
      if (!head) continue;

      head.updateWorldMatrix?.(true, false);
      const m = head.matrixWorld?.elements;
      if (!m) continue;

      const projected = point(head, view, projection, rect.width, rect.height);
      if (!projected) continue;

      const distance = Math.hypot(projected[0] - centerX, projected[1] - centerY);
      if (distance >= bestDistance) continue;

      const dx = m[12] - sx, dy = m[13] - sy, dz = m[14] - sz;
      const length = Math.hypot(dx, dy, dz);
      if (length < 0.01) continue;

      best = [dx / length, dy / length, dz / length];
      bestDistance = distance;
    }
    return best;
  }

  function ensureFireHook() {
    const g = window.game;
    if (!g || typeof g.fireBullet !== 'function') return;
    if (g === hookedGame && g.fireBullet.__rawsSilentAim) return;

    const original = g.fireBullet;
    g.fireBullet = function(shooter, x, y, z, dx, dy, dz, weapon) {
      if (shooter === this.player && this.state === 'playing' && cfg.silentAim) {
        try {
          const target = aimTarget(this, x, y, z);
          if (target) [dx, dy, dz] = target;
        } catch {}
      }
      return original.call(this, shooter, x, y, z, dx, dy, dz, weapon);
    };
    g.fireBullet.__rawsSilentAim = true;
    hookedGame = g;
  }

  function fovCircleFrame() {
    if (isUnloaded) return;
    requestAnimationFrame(fovCircleFrame);
    const g = window.game;
    const active = !!(cfg.silentAim && cfg.silentCircle && g?.state === 'playing');
    if (!overlay) return;
    overlay.style.display = active ? 'block' : 'none';
    if (!active) return;

    const canvas = g.renderer?.domElement || document.querySelector('#game canvas');
    if (!canvas) return;
    const bounds = canvas.getBoundingClientRect();
    if (bounds.width <= 0 || bounds.height <= 0) return;
    const now = performance.now();
    if (cfg.perfFovRefresh && now - lastFovRenderAt < 100) return;
    lastFovRenderAt = now;

    overlay.style.left = `${bounds.left}px`;
    overlay.style.top = `${bounds.top}px`;
    overlay.style.width = `${bounds.width}px`;
    overlay.style.height = `${bounds.height}px`;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    if (overlay.width !== Math.round(bounds.width * dpr) || overlay.height !== Math.round(bounds.height * dpr)) {
      overlay.width = Math.round(bounds.width * dpr);
      overlay.height = Math.round(bounds.height * dpr);
    }

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, bounds.width, bounds.height);

    ctx.save();
    ctx.beginPath();
    ctx.arc(bounds.width / 2, bounds.height / 2, Number(cfg.silentFov) || 120, 0, Math.PI * 2);
    ctx.strokeStyle = cfg.silentCircleColor;
    ctx.globalAlpha = Math.max(.1, Math.min(1, Number(cfg.silentCircleOpacity) / 100 || .85));
    ctx.lineWidth = Math.max(.5, Math.min(5, Number(cfg.silentCircleWidth) || 1.25));
    ctx.stroke();
    ctx.restore();
  }

  // =====================================================
  // COSMETIC TEXTURE PIPELINE
  // =====================================================
  const finishImages = new Map();
  const viewmodelOriginals = new Map();

  const FINISH_PALETTES = {
    crimson: ['#170307','#7d0c1b','#ff334d'], emerald: ['#02140d','#087846','#5dffb0'],
    sapphire: ['#030b1d','#124fa5','#63bdff'], gold: ['#241500','#a76b08','#ffe58a'],
    fade: ['#ff58c8','#745cff','#48d9ff'], ice: ['#dffaff','#6bdcff','#ffffff'],
    obsidian: ['#020204','#171022','#5c2d78'], tiger: ['#d96a00','#d96a00','#17100a'],
    damascus: ['#59626b','#c7d0d5','#252b30'], digital: ['#18231c','#47604a','#111915'],
    galaxy: ['#050018','#391b70','#d458ff'], toxic: ['#071400','#48c000','#d7ff32'],
    lava: ['#120000','#d62b00','#ffd04d'], arctic: ['#071728','#5dbfe8','#eaffff'],
    sunset: ['#301047','#f23f74','#ffbd5b'], ruby: ['#250006','#a00020','#ff6077'],
    amethyst: ['#10001e','#7020a0','#db8cff'], cobalt: ['#010d28','#144fbd','#72a8ff'],
    jade: ['#001b13','#098661','#7affc5']
  };

  function builtInFinish(name) {
    if (finishImages.has(name)) return finishImages.get(name);
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = 512;
    const context = canvas.getContext('2d');
    if (!context) return null;
    const colors = FINISH_PALETTES[name] || ['#252525','#777777','#eeeeee'];
    const gradient = context.createLinearGradient(0, 512, 512, 0);
    colors.forEach((color, index) => gradient.addColorStop(index / (colors.length - 1), color));
    context.fillStyle = gradient;
    context.fillRect(0, 0, 512, 512);
    if (name === 'carbon') {
      context.fillStyle = '#111111'; context.fillRect(0, 0, 512, 512);
      for (let y = 0; y < 512; y += 32) for (let x = 0; x < 512; x += 32) {
        context.fillStyle = ((x / 32 + y / 32) % 2) ? '#262626' : '#090909';
        context.fillRect(x, y, 30, 30);
      }
    } else if (name === 'neon') {
      context.fillStyle = '#020205'; context.fillRect(0, 0, 512, 512);
      context.lineWidth = 8;
      for (let i = -512; i < 1024; i += 52) {
        context.strokeStyle = i % 104 ? '#ff1f78' : '#21e6ff';
        context.beginPath(); context.moveTo(i, 0); context.lineTo(i - 512, 512); context.stroke();
      }
    } else if (name === 'tiger') {
      context.lineWidth = 22; context.strokeStyle = '#17100a';
      for (let i = -400; i < 900; i += 70) {
        context.beginPath(); context.moveTo(i, 0);
        context.bezierCurveTo(i + 130, 150, i - 80, 350, i + 80, 512); context.stroke();
      }
    } else if (name === 'damascus') {
      for (let y = 0; y < 512; y += 12) {
        context.strokeStyle = y % 24 ? '#c7d0d5' : '#252b30'; context.beginPath();
        for (let x = 0; x <= 512; x += 8) {
          const py = y + Math.sin(x / 24 + y / 31) * 9;
          if (x) context.lineTo(x, py); else context.moveTo(x, py);
        }
        context.stroke();
      }
    } else {
      context.globalAlpha = 0.16; context.fillStyle = '#ffffff';
      for (let i = 0; i < 18; i++) context.fillRect(-200 + i * 55, 0, 18, 720);
      context.globalAlpha = 1;
    }
    finishImages.set(name, canvas);
    return canvas;
  }

  function currentWeaponTextureImage(currentWeapon) {
    if (!cfg.skinChanger || !currentWeapon) return null;
    if (currentWeapon === 'knife') {
      if (cfg.skinKnifeFinish === 'native') return null;
      if (cfg.skinKnifeFinish === 'custom') return customKnifeTextureImage;
      return builtInFinish(cfg.skinKnifeFinish);
    } else {
      const finish = cfg.gunFinishes[currentWeapon] || 'native';
      if (finish === 'native') return null;
      if (finish === 'custom') return customGunTextureImages.get(currentWeapon) || null;
      return builtInFinish(finish);
    }
  }

  function isHeldWeaponMesh(g, mesh) {
    const roots = [g?.kx7?.rig?.gun, g?.viewmodel?.current?.children?.[0]].filter(Boolean);
    for (let node = mesh; node; node = node.parent) if (roots.includes(node)) return true;
    return false;
  }

  function disposeViewmodelEntry(entry) {
    entry.textures.forEach(texture => texture?.dispose?.());
    const originals = Array.isArray(entry.original) ? entry.original : [entry.original];
    entry.owned.forEach((material, index) => {
      if (material && material !== originals[index]) material.dispose?.();
    });
  }

  function restoreViewmodelMaterials() {
    for (const [mesh, entry] of viewmodelOriginals) {
      if (mesh.material === entry.cloned) mesh.material = entry.original;
      disposeViewmodelEntry(entry);
    }
    viewmodelOriginals.clear();
    trackedViewmodelScene = null;
  }

  function updateWeaponViewmodelTexture(g, currentWeapon) {
    const scene = g?.viewmodel?.scene;
    const image = currentWeaponTextureImage(currentWeapon);
    if (!scene || !image) {
      if (viewmodelOriginals.size) restoreViewmodelMaterials();
      return;
    }
    if (trackedViewmodelScene && trackedViewmodelScene !== scene) restoreViewmodelMaterials();
    trackedViewmodelScene = scene;
    const present = new Set();
    scene.traverse?.(mesh => {
      if (!mesh?.isMesh || !mesh.material || !mesh.geometry?.attributes?.uv || !isHeldWeaponMesh(g, mesh)) return;
      present.add(mesh);
      let entry = viewmodelOriginals.get(mesh);
      if (entry && mesh.material !== entry.cloned) {
        disposeViewmodelEntry(entry); viewmodelOriginals.delete(mesh); entry = null;
      }
      if (!entry) {
        const original = mesh.material;
        const sources = Array.isArray(original) ? original : [original];
        const owned = sources.map(material => material?.clone?.() || material);
        const cloned = Array.isArray(original) ? owned : owned[0];
        entry = { original, owned, cloned, textures: [], image: null };
        viewmodelOriginals.set(mesh, entry);
        mesh.material = cloned;
      }
      if (entry.image !== image) {
        entry.textures.forEach(texture => texture?.dispose?.());
        entry.textures = [];
        const sources = Array.isArray(entry.original) ? entry.original : [entry.original];
        entry.owned.forEach((material, index) => {
          if (!material) return;
          const sourceMap = sources[index]?.map;
          const TexClass = sourceMap?.constructor || window.THREE?.Texture;
          if (!TexClass) return;

          const texture = new TexClass(image);
          texture.flipY = sourceMap ? sourceMap.flipY : false;
          texture.needsUpdate = true;

          material.map = texture;
          material.needsUpdate = true;
          entry.textures.push(texture);
        });
        entry.image = image;
      }
    });
    for (const [mesh, entry] of viewmodelOriginals) {
      if (present.has(mesh)) continue;
      if (mesh.material === entry.cloned) mesh.material = entry.original;
      disposeViewmodelEntry(entry);
      viewmodelOriginals.delete(mesh);
    }
  }

  function unloadScript() {
    isUnloaded = true;
    restoreViewmodelMaterials();
    if (hookedGame?.__rawsSkinHook?.originalPov) {
      hookedGame._povLoadout = hookedGame.__rawsSkinHook.originalPov;
      delete hookedGame.__rawsSkinHook;
    }
    window.__rawsClientGUI = false;
    document.getElementById('raws-client-host')?.remove();
    overlay?.remove();
    document.body.style.cursor = '';
  }

  // =====================================================
  // SKINCHANGER HOOKS
  // =====================================================
  function installSkinChangerHooks(g) {
    if (g.__rawsSkinHook || typeof g._povLoadout !== 'function') return;
    const originalPov = g._povLoadout;

    g._povLoadout = function(entity, ...args) {
      const base = originalPov.call(this, entity, ...args);
      if (!cfg.skinChanger || (entity && entity !== this.player) || !base) return base;
      if (this.weapons?.current !== 'knife') return base;

      const model = cfg.skinKnifeModel;
      if (model === 'native' || !SKIN_KNIFE_MODELS.includes(model)) return base;

      return { ...base, paintOpts: { ...(base.paintOpts || {}) }, wid: model };
    };
    g.__rawsSkinHook = { originalPov };
  }

  function updateRuntimeSkinChanger(g) {
    installSkinChangerHooks(g);
    const current = g.weapons?.current;

    if (current !== lastObservedWeapon) {
      lastObservedWeapon = current;
      restoreViewmodelMaterials();
    }

    if (!cfg.skinChanger || !current) {
      restoreViewmodelMaterials();
      lastSkinScanAt = 0;
      return;
    }

    const now = performance.now();
    const interval = Math.max(50, Math.min(1000, Number(cfg.perfSkinInterval) || 150));
    if (!cfg.perfSkinScan || now - lastSkinScanAt >= interval) {
      lastSkinScanAt = now;
      updateWeaponViewmodelTexture(g, current);
    }
  }

  function mainLoop() {
    if (isUnloaded) return;
    requestAnimationFrame(mainLoop);
    const g = window.game;
    if (!g) return;
    try {
      ensureFireHook();
      updateRuntimeSkinChanger(g);
    } catch {}
  }
  requestAnimationFrame(mainLoop);

  // =====================================================
  // INTERFEJS UŻYTKOWNIKA (UI)
  // =====================================================
  const tabs = ['Skins', 'Performance', 'Silent Aim', 'Settings'];
  const skinSubTabs = [
    { id: 'Models', label: 'Knife Models' },
    { id: 'Textures', label: 'Knife Wraps' },
    { id: 'GunWraps', label: 'Guns' }
  ];

  const elem = (tag, className, text) => {
    const x = document.createElement(tag);
    if (className) x.className = className;
    if (text != null) x.textContent = text;
    return x;
  };

  function section(name, description) {
    const panel = elem('section', 'section');
    panel.append(elem('strong', 'section-title', name));
    if (description) panel.append(elem('p', 'desc', description));
    (pageBody || page).append(panel);
    return panel;
  }

  function check(parent, label, key) {
    const row = elem('label', 'field');
    row.append(document.createTextNode(label));
    const input = elem('input');
    input.type = 'checkbox';
    input.checked = !!cfg[key];
    input.onchange = () => { cfg[key] = input.checked; save(); };
    row.append(input);
    parent.append(row);
  }

  function rangeField(parent, label, key, min, max, step, unit) {
    const row = elem('label', 'field');
    const text = elem('span');
    const input = elem('input');
    Object.assign(input, { type: 'range', min: String(min), max: String(max), step: String(step), value: String(cfg[key]) });
    input.style.width = '150px';
    const update = () => {
      cfg[key] = Math.max(min, Math.min(max, Number(input.value)));
      text.textContent = `${label}: ${cfg[key]}${unit}`;
    };
    update();
    input.oninput = () => { update(); save(); };
    row.append(text, input);
    parent.append(row);
  }

  function renderNav() {
    nav.replaceChildren();
    tabs.forEach(name => {
      const b = elem('button', 'nav' + (cfg.tab === name ? ' active' : ''), name);
      b.onclick = () => { cfg.tab = name; save(); renderNav(); renderPage(); };
      nav.append(b);
    });
  }

  function renderPage() {
    page.replaceChildren();
    pageBody = elem('div', cfg.tab === 'Skins' ? '' : 'panel-grid');
    page.append(elem('h2', '', cfg.tab), pageBody);

    if (cfg.tab === 'Performance') {
      const p = section('Optymalizacja wydajności', 'Bezpieczne optymalizacje klienta. Nie wyłączają renderowania przeciwników ani elementów mapy.');
      check(p, 'Ogranicz skanowanie meshy broni (mniej pracy CPU)', 'perfSkinScan');
      rangeField(p, 'Interwał skanowania broni', 'perfSkinInterval', 50, 1000, 25, ' ms');
      check(p, 'Ogranicz odświeżanie kółka FOV do 10 FPS', 'perfFovRefresh');

      const note = elem('p', 'desc', 'Frustum culling jest już standardowo obsługiwany przez Three.js. Nie dokładamy drugiego, ryzykownego cullingu, który mógłby ukrywać przeciwników. Distance/occlusion culling wymaga jeszcze rozpoznania obiektów sceny gry.');
      p.append(note);
    } else if (cfg.tab === 'Silent Aim') {
      const s = section('Silent Aim Configuration', 'Automatyczne trafianie w głowę w obrębie FOV.');
      check(s, 'Włącz Silent Aim', 'silentAim');
      check(s, 'Pokaż okrąg FOV', 'silentCircle');
      rangeField(s, 'Promień FOV', 'silentFov', 20, 500, 5, ' px');
    } else if (cfg.tab === 'Settings') {
      const d = section('Library', 'Menu management.');
      const warning = elem('p', 'desc', 'Removes the RawS Client menu from the screen. Active game changes and background features are not reset.');
      const unloadBtn = elem('button', 'danger-btn', 'UNLOAD LIBRARY');
      unloadBtn.onclick = () => {
        isUnloaded = true;
        openMenu(false);
        document.getElementById('raws-client-host')?.remove();
      };
      d.append(warning, unloadBtn);
    } else if (cfg.tab === 'Skins') {
      const subNav = elem('div', 'sub-nav');
      skinSubTabs.forEach(sub => {
        const btn = elem('button', 'sub-btn' + (cfg.skinSubTab === sub.id ? ' active' : ''), sub.label);
        btn.onclick = () => { 
          cfg.skinSubTab = sub.id; 
          if (sub.id !== 'GunWraps') cfg.selectedGun = null;
          save(); 
          renderPage(); 
        };
        subNav.append(btn);
      });
      pageBody.append(subNav);

      const masterToggle = section('Globalny Skinchanger', 'Włącz lub wyłącz modyfikację skinów.');
      check(masterToggle, 'Włącz Skinchanger', 'skinChanger');

      if (cfg.skinSubTab === 'Models') {
        const knivesSec = section('Wybierz Model Noża', 'Wybierz wygląd modelu. Zmiana jest stosowana tylko wtedy, gdy trzymasz nóż.');
        const grid = elem('div', 'grid-container');

        const nativeCard = elem('div', 'tile' + (cfg.skinKnifeModel === 'native' ? ' selected' : ''), 'Domyślny');
        nativeCard.onclick = () => { cfg.skinKnifeModel = 'native'; save(); renderPage(); };
        grid.append(nativeCard);

        SKIN_KNIFE_MODELS.forEach(model => {
          const name = titlecase(model.replace(/^knife_/, ''));
          const tile = elem('div', 'tile' + (cfg.skinKnifeModel === model ? ' selected' : ''), name);
          tile.onclick = () => { cfg.skinKnifeModel = model; save(); renderPage(); };
          grid.append(tile);
        });
        knivesSec.append(grid);

      } else if (cfg.skinSubTab === 'Textures') {
        const texturesSec = section('Wybierz Wrap / Teksturę Noża', 'Każda tekstura to osobny kafelek. Stosowana tylko na nóż.');
        const grid = elem('div', 'grid-container');

        WRAP_FINISHES.forEach(finish => {
          const name = finish === 'native' ? 'Domyślna' : finish === 'custom' ? 'Własny plik (Custom)' : titlecase(finish);
          const tile = elem('div', 'tile' + (cfg.skinKnifeFinish === finish ? ' selected' : ''), name);
          tile.onclick = () => { cfg.skinKnifeFinish = finish; save(); renderPage(); };
          grid.append(tile);
        });
        texturesSec.append(grid);

        if (cfg.skinKnifeFinish === 'custom') {
          const customSec = section('Własna Tekstura Noża', 'Wgraj plik .png, .jpg, .webp');
          const picker = elem('input'); picker.type = 'file'; picker.accept = 'image/png,image/jpeg,image/webp'; picker.hidden = true;
          const upload = elem('button', 'danger-btn', 'Wybierz plik graficzny');
          const status = elem('p', 'desc', customKnifeTextureName ? 'Wgrano plik: ' + customKnifeTextureName : 'Brak wybranego pliku.');
          status.style.color = '#35e0b0';

          upload.onclick = () => picker.click();
          picker.onchange = async () => {
            const file = picker.files?.[0]; if (!file) return;
            try {
              await loadTextureFile(file, 'knife');
              status.textContent = 'Wgrano pomyślnie: ' + file.name;
            } catch (e) {
              status.textContent = 'Błąd wczytywania: ' + e.message;
            } finally {
              picker.value = '';
            }
          };
          customSec.append(upload, picker, status);
        }

      } else if (cfg.skinSubTab === 'GunWraps') {
        if (!cfg.selectedGun) {
          const gunsSec = section('Wybierz Broń Palną', 'Kliknij na broń, aby skonfigurować dla niej osobny wrap/skin.');
          const grid = elem('div', 'grid-container guns-grid');

          GAME_GUNS.forEach(gun => {
            const currentSkin = cfg.gunFinishes[gun.id] || 'native';
            const skinLabel = currentSkin === 'native' ? 'Domyślny' : titlecase(currentSkin);
            const tile = elem('div', 'tile gun-tile');
            const gunTitle = elem('strong', '', gun.name);
            const gunSkin = elem('span', '', `[${skinLabel}]`);
            tile.append(gunTitle, gunSkin);
            tile.onclick = () => { cfg.selectedGun = gun.id; save(); renderPage(); };
            grid.append(tile);
          });
          gunsSec.append(grid);

        } else {
          const activeGunObj = GAME_GUNS.find(g => g.id === cfg.selectedGun) || { name: cfg.selectedGun };
          const backSec = section('Edycja skina dla: ' + activeGunObj.name, 'Wybierz wrap dla tej konkretnej broni.');
          
          const backBtn = elem('button', 'danger-btn', '← Powrót do listy broni');
          backBtn.style.marginBottom = '12px';
          backBtn.onclick = () => { cfg.selectedGun = null; save(); renderPage(); };
          backSec.append(backBtn);

          const grid = elem('div', 'grid-container');
          const currentGunFinish = cfg.gunFinishes[cfg.selectedGun] || 'native';

          WRAP_FINISHES.forEach(finish => {
            const name = finish === 'native' ? 'Domyślna' : finish === 'custom' ? 'Własny plik (Custom)' : titlecase(finish);
            const tile = elem('div', 'tile' + (currentGunFinish === finish ? ' selected' : ''), name);
            tile.onclick = () => {
              cfg.gunFinishes[cfg.selectedGun] = finish;
              save();
              renderPage();
            };
            grid.append(tile);
          });
          backSec.append(grid);

          if (currentGunFinish === 'custom') {
            const currentGunCustomName = customGunTextureNames.get(cfg.selectedGun) || '';
            const customSec = section('Własna Tekstura dla: ' + activeGunObj.name, 'Wgraj plik graficzny (.png, .jpg, .webp)');
            const picker = elem('input'); picker.type = 'file'; picker.accept = 'image/png,image/jpeg,image/webp'; picker.hidden = true;
            const upload = elem('button', 'danger-btn', 'Wybierz plik graficzny dla tej broni');
            const status = elem('p', 'desc', currentGunCustomName ? 'Wgrano plik: ' + currentGunCustomName : 'Brak wybranego pliku dla tej broni.');
            status.style.color = '#35e0b0';

            upload.onclick = () => picker.click();
            picker.onchange = async () => {
              const file = picker.files?.[0]; if (!file) return;
              try {
                await loadTextureFile(file, 'gun', cfg.selectedGun);
                status.textContent = 'Wgrano pomyślnie: ' + file.name;
              } catch (e) {
                status.textContent = 'Błąd wczytywania: ' + e.message;
              } finally {
                picker.value = '';
              }
            };
            customSec.append(upload, picker, status);
          }
        }
      }
    }
  }

  function position() {
    const width = Math.min(800, window.innerWidth - 20);
    const height = Math.min(520, window.innerHeight - 20);
    cfg.x = Math.max(10, Math.min(cfg.x ?? (window.innerWidth - width) / 2, window.innerWidth - width - 10));
    cfg.y = Math.max(10, Math.min(cfg.y ?? (window.innerHeight - height) / 2, window.innerHeight - height - 10));
    box.style.left = cfg.x + 'px';
    box.style.top = cfg.y + 'px';
  }

